# Build directories (Qt Creator puts them in build/ by default)
build/
build-*/
cmake-build-*/
out/

# Qt Creator per-user files (absolute paths and kit IDs, different on every machine)
CMakeLists.txt.user*
*.user
*.autosave
.qtcreator/

# QML language server config (regenerated by Qt)
.qmlls.ini

# CMake generated files (only matter if you configure in-source)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CMakeUserPresets.json

# Qt generated code
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_qmltyperegistrations.cpp
*.qmlc
*.jsc

# Compiled output
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.exe
*.dll
*.pdb

# Editors and OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

!libs/**